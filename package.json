{
  "name": "khadamati",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production bun run db:push && (bun run db:seed &) && vite preview",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "db:push": "bunx drizzle-kit push",
    "db:seed": "bun run server/db/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4",
    "@tanstack/ai": "^0.42.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.34",
    "@tanstack/start-plugin": "^1.111.2",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.22.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "shadcn": "latest"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.18",
    "@types/bun": "^1.3.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3",
    "vite": "^8"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
